{
  "name": "sai-sai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:add": "npm run build && npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^8.3.1",
    "@capacitor/cli": "^7.4.3"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@gingersnapsoftware/capacitor-plugin-printer": "^0.0.15",
    "xlsx": "^0.18.5",
    "html2canvas": "^1.4.1",
    "@capacitor/app": "^7.1.2",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor-community/speech-recognition": "npm:@capgo/capacitor-speech-recognition@7.0.0",
    "@capacitor-community/text-to-speech": "6.1.0"
  }
}
